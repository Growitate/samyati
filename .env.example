# Samyati Environment Variables Template
# Copy this file to .env and set your private keys

# Groq API Key for AI Travel Advisor (Server-side)
GROQ_API_KEY=your_groq_api_key_here

# Server Port (default: 7392)
PORT=7392

# Admin Credentials
SAMYATI_ADMIN_PASSWORD=your_secure_admin_password
SAMYATI_TOKEN_SECRET=your_secure_vault_token_secret
